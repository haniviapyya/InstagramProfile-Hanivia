<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ================= HEADER ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/username"
                android:textColor="@color/dark_green"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="+"
                android:textColor="@color/dark_green"
                android:textSize="25sp" />

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="⋮"
                android:textColor="@color/dark_green"
                android:textSize="25sp" />

        </LinearLayout>


        <!-- ================= PROFILE ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <!-- FOTO PROFIL -->

            <ImageView
                android:id="@+id/profileImage"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:background="@drawable/bg_profile"
                android:clipToOutline="true"
                android:outlineProvider="background"
                android:scaleType="centerCrop"
                android:src="@drawable/profile" />


            <!-- NAMA + STATISTIK -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp">

                <!-- NAMA -->

                <TextView
                    android:id="@+id/txtName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/student_name"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- STATISTIK -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- POST -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/posts"
                            android:textColor="@color/dark_green"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="post"
                            android:textColor="@color/gray"
                            android:textSize="11sp" />

                    </LinearLayout>


                    <!-- FOLLOWER -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/followers"
                            android:textColor="@color/dark_green"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="follower"
                            android:textColor="@color/gray"
                            android:textSize="11sp" />

                    </LinearLayout>


                    <!-- FOLLOWING -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/following"
                            android:textColor="@color/dark_green"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="following"
                            android:textColor="@color/gray"
                            android:textSize="11sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>


        <!-- ================= BIO ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="5dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/txtBio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bio"
                android:textColor="@color/text_dark"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bio_detail"
                android:textColor="@color/gray"
                android:textSize="12sp" />

        </LinearLayout>


        <!-- ================= BUTTON ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="20dp">

            <Button
                android:id="@+id/btnEdit"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_button_green"
                android:text="@string/edit_profile"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_button_outline"
                android:text="@string/share_profile"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp" />

        </LinearLayout>


        <!-- ================= HIGHLIGHTS ================= -->

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="15dp"
                android:paddingEnd="15dp">

                <LinearLayout
                    android:layout_width="75dp"
                    android:layout_height="105dp"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="65dp"
                        android:background="@drawable/bg_circle"
                        android:gravity="center"
                        android:text="🌿"
                        android:textSize="25sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/about"
                        android:textColor="@color/gray"
                        android:textSize="11sp" />

                </LinearLayout>


                <LinearLayout
                    android:layout_width="75dp"
                    android:layout_height="105dp"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="65dp"
                        android:background="@drawable/bg_circle"
                        android:gravity="center"
                        android:text="🎓"
                        android:textSize="25sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/campus"
                        android:textColor="@color/gray"
                        android:textSize="11sp" />

                </LinearLayout>


                <LinearLayout
                    android:layout_width="75dp"
                    android:layout_height="105dp"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="65dp"
                        android:background="@drawable/bg_circle"
                        android:gravity="center"
                        android:text="☕"
                        android:textSize="25sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hobby"
                        android:textColor="@color/gray"
                        android:textSize="11sp" />

                </LinearLayout>


                <LinearLayout
                    android:layout_width="75dp"
                    android:layout_height="105dp"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="65dp"
                        android:background="@drawable/bg_circle"
                        android:gravity="center"
                        android:text="📷"
                        android:textSize="25sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/daily"
                        android:textColor="@color/gray"
                        android:textSize="11sp" />

                </LinearLayout>


                <LinearLayout
                    android:layout_width="75dp"
                    android:layout_height="105dp"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="65dp"
                        android:background="@drawable/bg_circle"
                        android:gravity="center"
                        android:text="♡"
                        android:textSize="30sp"
                        android:textColor="@color/sage" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/favorite"
                        android:textColor="@color/gray"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

        </HorizontalScrollView>


        <!-- ================= TABS ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="5dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="▦"
                android:textColor="@color/dark_green"
                android:textSize="25sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="▷"
                android:textColor="@color/light_gray"
                android:textSize="23sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="♡"
                android:textColor="@color/light_gray"
                android:textSize="28sp" />

        </LinearLayout>


        <!-- ================= POST GRID ================= -->

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="3">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:layout_margin="1dp"
                android:scaleType="centerCrop"
                android:src="@drawable/post1" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:layout_margin="1dp"
                android:scaleType="centerCrop"
                android:src="@drawable/post2" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:layout_margin="1dp"
                android:scaleType="centerCrop"
                android:src="@drawable/post3" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:layout_margin="1dp"
                android:scaleType="centerCrop"
                android:src="@drawable/post4" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:layout_margin="1dp"
                android:scaleType="centerCrop"
                android:src="@drawable/post5" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:layout_margin="1dp"
                android:scaleType="centerCrop"
                android:src="@drawable/post6" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:layout_margin="1dp"
                android:scaleType="centerCrop"
                android:src="@drawable/post7" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:layout_margin="1dp"
                android:scaleType="centerCrop"
                android:src="@drawable/post8" />

            <ImageView
                android:id="@+id/postLike"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:layout_margin="1dp"
                android:scaleType="centerCrop"
                android:src="@drawable/post9" />

        </GridLayout>


        <!-- ================= BOTTOM NAV ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@color/white"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="⌂"
                android:textColor="@color/dark_green"
                android:textSize="28sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="⌕"
                android:textColor="@color/gray"
                android:textSize="28sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="+"
                android:textColor="@color/gray"
                android:textSize="28sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="♡"
                android:textColor="@color/gray"
                android:textSize="28sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="●"
                android:textColor="@color/sage"
                android:textSize="18sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>